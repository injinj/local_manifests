<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="injinj"
          fetch="git@github.com:injinj/" />
  <remote name="aohp"
          fetch="git@github.com:aohp-os/" />


  <!-- ========== device/google/cuttlefish ========== -->
  <remove-project name="device/google/cuttlefish" />

  <project name="device_google_cuttlefish"
           path="device/google/cuttlefish"
           remote="aohp"
           revision="main" />

  <!-- ========== platform/build → build/make ========== -->
  <remove-project name="platform/build" />
  <!-- 与 default.xml 中 platform/build 一致：在源码根创建 build/* 符号链接 -->
  <project name="build_make"
           path="build/make"
           remote="injinj"
           revision="injinj-main">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <!-- ========== platform/frameworks/base ========== -->
  <remove-project name="platform/frameworks/base" />

  <project name="platform_frameworks_base"
           path="frameworks/base"
           remote="aohp"
           revision="main" />

  <!-- ========== platform/system/core ========== -->
  <remove-project name="platform/system/core" />

  <project name="platform_system_core"
           path="system/core"
           remote="injinj"
           revision="injinj-main" />

  <!-- ========== platform/system/sepolicy ========== -->
  <remove-project name="platform/system/sepolicy" />

  <project name="platform_system_sepolicy"
           path="system/sepolicy"
           remote="injinj"
           revision="injinj-main" />

  <!-- ========== platform/packages/apps/Launcher3 ========== -->
  <remove-project name="platform/packages/apps/Launcher3" />

  <project name="packages_apps_launcher3"
           path="packages/apps/Launcher3"
           remote="aohp"
           revision="main" />

  <!-- ========== AOHP Agent Driver ========== -->
  <project name="AOHPAgentDriver"
           path="packages/apps/AOHPAgentDriver"
           remote="injinj"
           revision="injinj-main" />


</manifest>
